# ---------------------------------------------------------------
# Secrets — never commit these.
# Real API keys live in ~/.config/zsh/secrets.zsh (outside this repo).
# ---------------------------------------------------------------
secrets.zsh
**/secrets.zsh
*.secret
credentials.json

# env files
.env
.env.*
!.env.example

# keys / certs
*.pem
*.p12
*.pfx
*.key

# tokens
*.token
id_rsa
id_ed25519

# macOS
.DS_Store
._*

# editor / tooling cruft
*.swp
*~
.idea/

# tmux plugins are installed and updated by tpm (see tmux.conf), not committed
# (they were previously tracked as gitlinks with no .gitmodules, which left
#  a fresh clone with 11 empty directories)
tmux/plugins/
