[user]
    name = N. Goncalves
    email = nuno@nunocgoncalves.com

# Signing is intentionally OFF: the signing key lived on a hardware token
# that is no longer in use. Commits and tags are unsigned.
[commit]
    gpgSign = false
[tag]
    gpgSign = false

[init]
    defaultBranch = master
[fetch]
    prune = true
[push]
    autoSetupRemote = true
[rerere]
    enabled = true
[merge]
    conflictstyle = zdiff3
[diff]
    algorithm = histogram
[rebase]
    autosquash = true
[help]
    autocorrect = 10

[core]
    excludesfile = ~/.gitignore_global

[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
