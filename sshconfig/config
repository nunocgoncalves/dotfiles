# Defaults for every host.
#
# NOTE: UseKeychain is an Apple-only extension and is FATAL under Homebrew's
# openssh ("Bad configuration option"). That formula is deliberately not
# installed so /usr/bin/ssh (Apple's) is used — see homebrew/Brewfile.
Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3

Host github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_ed25519

Host opnsense
  User nuno
  HostName 10.177.250.1
  IdentityFile ~/.ssh/id_ed25519_opnsense

Host crs326-core
  User nuno
  HostName 10.177.12.2
  IdentityFile ~/.ssh/id_ed25519_crs326-core

Host r2dqgjo8
  User forge
  HostName 10.177.10.10
  IdentityFile ~/.ssh/id_ed25519_r2dqgjo8
